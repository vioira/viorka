# Copy to .env. Existing process environment variables take precedence.
VIORKA_LISTEN=127.0.0.1:8080
VIORKA_DATABASE=data/viorka.db
# Canonical public origin. Existing databases use saved settings.
VIORKA_ORIGIN=http://127.0.0.1:5173
# Optional extra trusted browser origins, comma-separated; restart to apply.
# VIORKA_ALLOWED_ORIGINS=http://localhost:5173,https://console.example.com
# Defaults to admin. Password is generated only for an empty user table.
VIORKA_ADMIN_USERNAME=admin
# Optional compatibility override; otherwise a private password file is generated.
# VIORKA_ADMIN_PASSWORD_FILE=/absolute/path/to/private-password
# VIORKA_TLS_CERT=/absolute/path/to/cert.pem
# VIORKA_TLS_KEY=/absolute/path/to/key.pem

# Optional local MaxMind GeoLite2 City / GeoIP2 City MMDB. Restart after replacing it.
# VIORKA_GEOIP_DATABASE=/absolute/path/to/GeoLite2-City.mmdb

# Optional node-only online fallback when local country lookup misses (default false).
# Uses https://ipinfo.io/<IP>/json; token is optional. Restart to apply.
# VIORKA_IPINFO_FALLBACK=true
# VIORKA_IPINFO_TOKEN=
