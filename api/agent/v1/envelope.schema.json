{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vioira.example/spec/viorka/agent/v1/envelope.schema.json",
  "title": "Viorka Agent Protocol v1 Envelope (design contract)",
  "description": "消息包装结构。约定协议目标，M0 期间实现握手和端到端联测。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "message_id",
    "type",
    "sent_at",
    "payload"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object"
    }
  }
}
